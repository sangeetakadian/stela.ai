{
    "version": 2,
    "installCommand": "flutter pub get --enforce-lockfile",
    "buildCommand": "bash scripts/build_vercel.sh",
    "outputDirectory": "build/web",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}